---
import BaseLayout from '../../layouts/BaseLayout.astro';
import sqlite3 from 'sqlite3';
import * as CollectionsModel from '../../models/collections';


async function getBookReviewSeries(db: sqlite3.Database) {
    const seriesWithTerms = await CollectionsModel.getAllReviewTargetSeriesWithTerms(db);
    if (!seriesWithTerms) {
        return [];
    }
    const results = [] as { id: number; title: string; terms: number[] }[];
    for (const series of seriesWithTerms) {
        const item = results.find(x => x.id === series.seriesId);
        if (item) {
            if (!item.terms.includes(series.term)) {
                item.terms.push(series.term);
            }
            continue;
        }
        results.push({
            id: series.seriesId,
            title: series.seriesTitle,
            terms: [series.term]
        });
    }
    return results;
}

const dbPath = import.meta.env.BIBLIODB_PATH;
const db = new sqlite3.Database(dbPath);
const reviews = await getBookReviewSeries(db);
const columnSize = reviews.reduce((max, review) => Math.max(max, review.terms.length), 0);

---
<BaseLayout pageTitle="趣味の雑誌の書評欄で紹介された本のリスト">
    <h2>趣味の雑誌の書評欄で紹介された本のリスト</h2>
    <div class="magazine-list">
        <table>
            <tbody>
                {
                    reviews.map((review) => (
                        <tr>
                            <td>{review.title}：</td>
                            <td>
                                { review.terms.includes(2025) ? <a href={`/bookreviews/${review.id}/2025`}>2025年</a> : null }
                            </td>
                            <td>
                                { review.terms.includes(2026) ? <a href={`/bookreviews/${review.id}/2026`}>2026年</a> : null }
                            </td>
                        </tr>
                    ))  
                }    
            </tbody>
        </table>
    </div>
</BaseLayout>

<style>
    h2 {
        text-align: center;
    }
    .magazine-list {
        text-align: center;
        table {
            width: auto;
            margin-left: auto;
            margin-right: auto;
            font-size: 1em;
        }
        table > tbody > tr:nth-child(even) {
            background-color: unset;
        }
        table > tbody > tr > td {
            padding: 0.5em;
        }
        table > tbody > tr > td:first-child {
            text-align: left;
        }
    }
</style>